# Merge these values into your existing .env; do not overwrite existing secrets.
# Optional until their adapters are used.
SEC_USER_AGENT=
FRED_API_KEY=

DCF_MOCK_LLM=true
DCF_OLLAMA_URL=http://127.0.0.1:11434
DCF_DATA_DIR=data
DCF_OUTPUT_DIR=outputs
DCF_MODELS_FILE=config/models.yaml

# Apply these separately to the Ollama server environment when setting it up.
# Reading .env in our Python app does not configure a running Ollama server.
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_NUM_PARALLEL=1
